# 1. Dose-Dependent Analysis - Identifying Dose-Response TFs
# Calculate the dose-response pattern for each TF
# Evaluate dose-response relationships using linear models

dose_response_analysis <- function(expression_vec, groups) {
  # Allocate numerical doses：NR=0, GY10=10, GY20=20, GY30=30
  dose_numeric <- ifelse(groups == "NR", 0,
                         ifelse(groups == "GY10", 10,
                                ifelse(groups == "GY20", 20, 30)))
  
  # Linear model
  lm_fit <- lm(expression_vec ~ dose_numeric)
  lm_summary <- summary(lm_fit)
  
  # Return slope, p-value, and R-squared
  return(c(
    slope = coef(lm_fit)[2],
    p_value = lm_summary$coefficients[2, 4],
    r_squared = lm_summary$r.squared
  ))
}

# Conduct a dose-response analysis for each TF
dose_response_results <- t(apply(tf_expression, 1, function(x) {
  dose_response_analysis(x, sample_groups)
}))

dose_response_df <- as.data.frame(dose_response_results)
dose_response_df$TF <- rownames(dose_response_df)
dose_response_df$adj_p_value <- p.adjust(dose_response_df$p_value, method = "BH")

# Marked Dose-Response TF
dose_response_df$significant <- dose_response_df$adj_p_value < 0.05 & 
  abs(dose_response_df$slope) > 0.1

cat("Significant dose-response TF count:", sum(dose_response_df$significant), "\n")

